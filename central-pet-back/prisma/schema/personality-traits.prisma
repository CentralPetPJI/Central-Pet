model PersonalityTrait {
  id                String   @id
  title             String
  description       String
  conflictsWithJson String   @default("[]")
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}
